# Copy to phpbox.conf and adjust. Applies to newly created environments.
HTTP_PORT=80              # shared proxy port for http://<name>.localhost
HTTPS_PORT=443            # shared proxy port for https://<name>.localhost
BASE_PORT=8080            # first port slot to try; DB port = slot + 10000
MAILPIT_PORT=18025        # shared mail catcher UI
PHPMYADMIN_PORT=18026     # shared phpMyAdmin
SHOP_LANG=pl              # default shop language (override per env: --lang en)
SHOP_COUNTRY=pl
SHOP_CURRENCY=PLN
SHOP_TZ=Europe/Warsaw
ADMIN_USER=admin          # Magento / WordPress login (PrestaShop logs in by e-mail)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
MAGENTO_PUBLIC_KEY=       # repo.magento.com access keys, required only by platform "magento"
MAGENTO_PRIVATE_KEY=
GITHUB_TOKEN=             # github.com token for private https repositories in composer.json

#!/usr/bin/env bash
# shellcheck disable=SC2034,SC2153
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BOXES_DIR="${PHPBOX_BOXES_DIR:-$ROOT/boxes}"
CACHE_DIR="$ROOT/cache"
BIN_DIR="$CACHE_DIR/bin"
UP_FILE="$BOXES_DIR/.up"

HTTP_PORT=80
HTTPS_PORT=443
BASE_PORT=8080
DB_PORT_OFFSET=10000
SHARED_HOSTS="phpmyadmin mailpit"
MAILPIT_PORT=18025
PHPMYADMIN_PORT=18026
SHOP_LANG=pl
SHOP_COUNTRY=pl
SHOP_CURRENCY=PLN
SHOP_TZ=Europe/Warsaw
ADMIN_USER="admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
MAGENTO_PUBLIC_KEY=""
MAGENTO_PRIVATE_KEY=""
GITHUB_TOKEN=""
CONF_FILE="${PHPBOX_CONF:-$ROOT/phpbox.conf}"
# shellcheck source=/dev/null
[[ -f "$CONF_FILE" ]] && source "$CONF_FILE"

PHP_IMAGE=mmilewski/php-fpm
PHP_VERSIONS="8.0 8.1 8.2 8.3 8.4 8.5"
DB_USER=shop DB_PASS=shop DB_ROOT_PASS=root
ENV_KEYS="PLATFORM NAME VERSION PORT DB_PORT DB_NAME PHP_VERSION DB_IMAGE DOWNLOAD_URL SHOP_HOST SHOP_LANG SHOP_COUNTRY SHOP_CURRENCY SHOP_TZ ADMIN_USER ADMIN_EMAIL ADMIN_PASSWORD HOST_UID HOST_GID KIND SERVICES"
OPT_NAME="" OPT_PHP="" OPT_BRANCH=""

for lib in core docker tls database commands; do
  # shellcheck source=/dev/null
  source "$ROOT/src/$lib.sh"
done

# Print help; commands, arguments and options are colored on a terminal unless NO_COLOR is set.
usage() {
  local text status="○ down"
  shared_running && status="● up"
  text=$(cat <<USAGE
phpbox — local PHP shops and apps on Docker, with snapshots

  create <platform> <version> [opts]   install (version: full | prefix | latest)
        [--name N] [--lang xx] [--php X.Y] [--<service>]  (+ platform options, see README)
  clone <platform> <git-repo> [opts]   project from a repository (no database)
        [--branch B] [--name N] [--php X.Y] [--<service>]
  db-import <name> <dump>              import database and configure it for local use
  copy <source> <name>                 copy an environment with its current database
  snapshot <name>                      current state becomes the new reset point
  reset <name> [--db-only]             restore snapshot (cloned project: database only)
  start|stop <name>                    start / stop one environment
  up|down                              start / stop phpbox (down remembers running environments)
  remove <name> [-y]                   remove environment with its database and files
  list [--size]                        list environments (--size: disk usage, slower)
  info <name>                          URLs, credentials, PHP, size, volumes, containers
  versions <platform>                  available versions
  shell <name> [service]               shell in the PHP (or given service) container
  db <name>                            MariaDB console
  logs <name>                          container logs

Platforms: $(platforms)
Services:  $(services)
Status:    $status
USAGE
)
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    sed -E \
      -e $'s/(\\[[^]]+\\])/\e[33m\\1\e[0m/g' \
      -e $'s/^(  )([a-z|-]+)/\\1\e[1;32m\\2\e[0m/' \
      -e $'s/( )(<[^>]+>)/\\1\e[36m\\2\e[0m/g' \
      -e $'s/(● up)/\e[1;32m\\1\e[0m/' \
      -e $'s/(○ down)/\e[1;31m\\1\e[0m/' \
      -e $'s/^(Platforms:|Services:|Status:)/\e[1m\\1\e[0m/' \
      -e $'1s/^(phpbox)/\e[1m\\1\e[0m/' <<<"$text"
  else
    echo "$text"
  fi
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

for b in docker rsync curl; do command -v "$b" >/dev/null || die "Missing program: $b"; done
cmd="${1:-help}"; shift || true
case "$cmd" in
  create|clone|copy|snapshot|reset|start|stop|up|down|remove|list|info|versions|shell|db|logs) "cmd_$cmd" "$@" ;;
  db-import) cmd_db_import "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
